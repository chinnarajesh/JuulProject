<aura:component implements="lightning:availableForFlowScreens,lightning:availableForFlowActions,flexipage:availableForAllPageTypes">
    <lightning:workspaceAPI aura:id="workspace" />
    <aura:attribute name="newRecordId" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.openTab }"/>   
</aura:component>