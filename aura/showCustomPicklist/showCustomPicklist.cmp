<aura:component implements="lightning:availableForFlowScreens" access="global" >
    <aura:attribute name="picklistValues" type="String[]" access="global" required="true" /> 
    <aura:attribute name="selectedValue" type="String" access="global" />
    <aura:attribute name="picklistLabel" type="String" access="global" required="true" />
    <lightning:select name="label" label="{!v.picklistLabel}" value="{!v.selectedValue}">  
        <aura:iteration items="{!v.picklistValues}" var="a" >
            <option text = "{!a}"></option>
        </aura:iteration>
    </lightning:select>
</aura:component>