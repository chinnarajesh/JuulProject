<aura:event type="COMPONENT" description="Dispatched when a select has changed value" >
  <aura:attribute name="values" type="String[]" description="Selected values" access="global" />
  <aura:attribute name="removed" type="String" description="Selected values" access="global" />
  <aura:attribute name="type" type="String" description="Selected Type" access="global" />
</aura:event>