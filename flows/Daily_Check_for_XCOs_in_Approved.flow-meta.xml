<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Looks for XCOs in the Approved phase so that they can be moved to the Implementation phase 
JK- Revised to add &quot;Implementation Required? &quot; field as true as the trigger logic</description>
    <interviewLabel>Daily Check for XCOs in Approved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Daily Check for XCOs in Approved</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Implementation_Quality_Review_phase_for_Change</name>
        <label>Get Implementation &amp; Quality Review phase for Change</label>
        <locationX>390</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Move_Change_to_Impl_Quality_Review</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <stringValue>Implementation</stringValue>
            </value>
        </filters>
        <filters>
            <field>PDLM__Change_lk__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PDLM__Change_Phase__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Move_Change_to_Impl_Quality_Review</name>
        <label>Move Change to Impl &amp; Quality Review</label>
        <locationX>534</locationX>
        <locationY>50</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PDLM__Status_lk__c</field>
            <value>
                <elementReference>Get_Implementation_Quality_Review_phase_for_Change.Id</elementReference>
            </value>
        </inputAssignments>
        <object>PDLM__Change__c</object>
    </recordUpdates>
    <start>
        <locationX>49</locationX>
        <locationY>51</locationY>
        <connector>
            <targetReference>Get_Implementation_Quality_Review_phase_for_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Change_Status_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>XCO</stringValue>
            </value>
        </filters>
        <filters>
            <field>PDLM__Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>a4P4T0000004iB7</stringValue>
            </value>
        </filters>
        <filters>
            <field>Implementation_Requiredpick__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <object>PDLM__Change__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2020-03-25</startDate>
            <startTime>00:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
