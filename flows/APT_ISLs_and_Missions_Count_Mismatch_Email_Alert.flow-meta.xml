    <decisions>
        <name>Check_the_ISLs_Missions_data</name>
        <label>Check the ISLs &amp; Missions data</label>
        <locationX>556</locationX>
        <locationY>684</locationY>
        <defaultConnector>
            <targetReference>APTs_looping</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_ISLs_Missions_have_in_APT</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>APTs_looping.Total_Instorelocations__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>APTs_looping.Total_Mission__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ISLs_Missions_count</targetReference>
            </connector>
            <label>If ISLs &amp; Missions have in APT</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_the_Missions_and_ISLs_count</name>
        <label>Check the Missions and ISLs count</label>
        <locationX>402</locationX>
        <locationY>900</locationY>
        <defaultConnector>
            <targetReference>APTs_looping</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Not_equal_to_Missions_and_ISLs_count</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>NumberOfParticipatingDoorsCount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>ISLsCount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NumberOfParticipatingDoorsCount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>MissionsCount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ISLsCount</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>MissionsCount</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign</targetReference>
            </connector>
            <label>If Not equal to Missions and ISLs count</label>
        </rules>
    </decisions>
