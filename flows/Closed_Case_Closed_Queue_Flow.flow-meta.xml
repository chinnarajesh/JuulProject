    <recordLookups>
        <description>Use the Market to retrieve the Closed Queue Name from &apos;CS Country Config &apos;  Metadata</description>
        <name>Get_Queue_Name_From_Metadata</name>
        <label>Get Queue Name From Metadata</label>
        <locationX>725</locationX>
        <locationY>44</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_the_Queue_ID</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Market__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>itemCase.Market__c</elementReference>
            </value>
        </filters>
        <object>CS_Country_Config__mdt</object>
        <outputAssignments>
            <assignToReference>closedCaseQueueName</assignToReference>
            <field>Closed_Case_Queue_Name__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <description>Get the Queue ID</description>
        <name>Get_the_Queue_ID</name>
        <label>Get the Queue ID</label>
        <locationX>878</locationX>
        <locationY>44</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Closed_Queue_ID_is_Not_Null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>closedCaseQueueName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <object>Group</object>
        <outputAssignments>
            <assignToReference>closedCaseQueueID</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
