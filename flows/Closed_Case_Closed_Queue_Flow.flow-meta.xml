    <decisions>
        <description>Only  continue if Case records belong to CS Record Types: 
App Troubleshooting
Ecommerce Account
General Inquiry
Product Troubleshooting &amp; Warranty Fulfillment
Health Experience</description>
        <name>Check_If_CS_Record_Type</name>
        <label>Check If CS Record Type</label>
        <locationX>471</locationX>
        <locationY>41</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CS_Record_Type</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>itemCase.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>0121O000000AYNXQA4</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>itemCase.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>01239000000UXufAAG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>itemCase.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>01239000000UXugAAG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>itemCase.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>01239000000UXukAAG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>itemCase.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>01239000000YSfTAAW</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Queue_Name_From_Metadata</targetReference>
            </connector>
            <label>CS Record Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Closed_Queue_ID_is_Not_Null</name>
        <label>Closed Queue ID is Not Null</label>
        <locationX>1040</locationX>
        <locationY>47</locationY>
        <defaultConnector>
            <targetReference>Assign_to_US_Closed_Cases_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Queue ID is Null</defaultConnectorLabel>
        <rules>
            <name>Queue_ID_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>closedCaseQueueID</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Queue_ID_to_Case</targetReference>
            </connector>
            <label>Queue ID is not null</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the Case Owner is  &apos;JUUL Auto-Replace&apos;, then don&apos;t update the Case Owner. The Case Owner should remain as &apos;JUUL Auto-Replace&apos;</description>
        <name>Owner_is_JUUL_Auto_Replace</name>
        <label>Owner is JUUL Auto-Replace</label>
        <locationX>163</locationX>
        <locationY>280</locationY>
        <defaultConnector>
            <targetReference>Check_If_CS_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>JUUL_Auto_Replace</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>itemCase.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>00G390000050BrWEAU</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Submit_For_Approval</targetReference>
            </connector>
            <label>JUUL Auto-Replace</label>
        </rules>
    </decisions>
