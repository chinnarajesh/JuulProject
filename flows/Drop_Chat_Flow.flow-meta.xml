            <conditions>
                <leftValueReference>Dropped_Chat2</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Before Interaction started</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varRecordTypeDeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
