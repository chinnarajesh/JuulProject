    <formulas>
        <name>revenuechangecalc</name>
        <dataType>Number</dataType>
        <expression>({!soV_account.Items_ordered_last_30__c} - {!soV_account.Revenue_last_31_60_Days_ago__c}) 
/ 
{!soV_account.Revenue_last_31_60_Days_ago__c} *100</expression>
        <scale>3</scale>
    </formulas>
