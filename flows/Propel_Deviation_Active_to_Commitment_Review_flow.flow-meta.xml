<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow to update the Deviation phase to Expired from Active</description>
    <environments>Default</environments>
    <interviewLabel>Propel Deviation - Active to Commitment Review flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Propel Deviation - Active to Expired flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Use variables to collect ID of Expired Phase</description>
        <name>Pull_Deviation_Com_Review_ID</name>
        <label>Pull Deviation Expired ID</label>
        <locationX>432</locationX>
        <locationY>313</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Deviation_with_Commitment_Review_ID</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </filters>
        <filters>
            <field>PDLM__Change_lk__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Deviation_ID_given_by_Process_Builder</elementReference>
            </value>
        </filters>
        <object>PDLM__Change_Phase__c</object>
        <outputAssignments>
            <assignToReference>Expired_Phase_Id</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Deviation_with_Commitment_Review_ID</name>
        <label>Update Deviation with Expired ID</label>
        <locationX>777</locationX>
        <locationY>112</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Deviation_ID_given_by_Process_Builder</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PDLM__Status_lk__c</field>
            <value>
                <elementReference>Expired_Phase_Id</elementReference>
            </value>
        </inputAssignments>
        <object>PDLM__Change__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>138</locationY>
        <connector>
            <targetReference>Pull_Deviation_Com_Review_ID</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>Commitment_Review_phase_ID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Deviation_ID_given_by_Process_Builder</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>Expired_Phase_Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
