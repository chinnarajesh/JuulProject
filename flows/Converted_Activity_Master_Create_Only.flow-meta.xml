        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Last_CSMActivity_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>last_CSM_Activity_formula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Last_CSM_Activity_Date</targetReference>
