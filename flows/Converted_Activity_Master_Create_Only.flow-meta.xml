    <environments>Default</environments>
    <formulas>
        <name>formula_CheckOutDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate} + ( 30/1440)</expression>
    </formulas>
    <formulas>
        <name>formula_CheckOutDate_new</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.CreatedDate} + ( 30/1440)</expression>
    </formulas>
    <formulas>
        <name>last_CSM_Activity_formula</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   NOT(ISBLANK( {!$Record.WhatId} )),
   BEGINS( {!$Record.WhatId} , &quot;001&quot;), 
   {!$Record.Owner:User.Profile.Id} = &quot;00e39000000xW2aAAE&quot;,
   OR(
      {!$Record.Account.RecordType.Id}= &quot;012700000005vMAAAY&quot;,
      {!$Record.Account.RecordType.Id} = &quot;012390000006DchAAE&quot;,
            {!$Record.Account.RecordType.Id}  = &quot;012700000005vY2AAI&quot;
   )
)</expression>
    </formulas>
    <formulas>
        <name>temp_formula</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   NOT(ISBLANK({!$Record.WhatId})), 
   BEGINS({!$Record.WhatId} , &quot;001&quot;), 
   OR(
      {!$Record.Account.RecordTypeId} = &quot;012700000005vMAAAY&quot;,
      {!$Record.Account.RecordTypeId} = &quot;012390000006DchAAE&quot;,
{!$Record.Account.RecordTypeId}= &quot;012700000005vY2AAI&quot;
   ),
   OR(
     {!$Record.Owner:User.Profile.Id} = &quot;00e70000000xT2bAAE&quot;,
     {!$Record.Owner:User.Profile.Id} = &quot;00e39000000xW2aAAE&quot;
   )
)</expression>
    </formulas>
    <interviewLabel>Converted_Activity_Master_Create_Only {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Converted_Activity_Master_Create_Only</label>
