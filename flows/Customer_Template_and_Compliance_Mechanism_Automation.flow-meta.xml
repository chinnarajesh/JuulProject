    <environments>Default</environments>
    <formulas>
        <name>FilteronlyOnePotencyBan</name>
        <dataType>String</dataType>
        <expression>TRIM( 
     RIGHT(
              {!potencyExtractedPicklistValues} , 
              FIND(
                     {!potencyExtractedPicklistValues},&quot;;&quot;
             ) - 1
       ) 
 )</expression>
    </formulas>
    <formulas>
        <name>formulaOnePicklistValue</name>
        <dataType>String</dataType>
        <expression>TRIM( 
     LEFT(
              {!formattedPicklistValues} , 
              FIND(
                     &quot;;&quot;,{!formattedPicklistValues}
             ) - 1
       ) 
 )</expression>
    </formulas>
    <formulas>
        <name>formulaRemoveBracketsAndAddSemiColon</name>
        <dataType>String</dataType>
        <expression>{!rawMultiSelectPicklistValues} +&quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>removeOnePicklistValue</name>
        <dataType>String</dataType>
        <expression>TRIM(
     SUBSTITUTE({!formattedPicklistValues},  {!formulaOnePicklistValue}+&quot;;&quot;, &quot;&quot;)
 )</expression>
    </formulas>
