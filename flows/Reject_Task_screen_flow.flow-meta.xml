    <decisions>
        <name>Determine_whether_current_user_is_Assignee</name>
        <label>Determine whether current user is Assignee</label>
        <locationX>527</locationX>
        <locationY>117</locationY>
        <defaultConnector>
            <targetReference>No_permission_to_Reject</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Don&apos;t Proceed</defaultConnectorLabel>
        <rules>
            <name>Proceed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task.PDLM__Assigned_To_Me__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Override_Permission_VR_to_True</targetReference>
            </connector>
            <label>Proceed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_the_user_have_permission_to_Reject</name>
        <label>Does the user have permission to Reject?</label>
        <locationX>653</locationX>
        <locationY>479</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>XCOTaskSuperUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>XCOTaskSuperUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>No</label>
        </rules>
    </decisions>
    <description>Add decision to determine if current user is assignee</description>
    <formulas>
        <description>user permission to reject/complete XCO tasks</description>
        <name>XCOTaskSuperUser</name>
        <dataType>Boolean</dataType>
        <expression>{!$Permission.XCO_Task_Super_User}</expression>
    </formulas>
