        <rules>
            <name>Open_New_Queue</name>
            <conditionLogic>(1 OR 2)</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCurrentCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Open_New_Cases_Get_Queue_ID</targetReference>
            </connector>
            <label>Open/New Queue</label>
        </rules>
        <rules>
            <name>Pending_Solved_Queue</name>
            <conditionLogic>(1 OR 2)</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pending</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCurrentCase.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Solved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pending_Solved_Cases_Get_Queue_ID</targetReference>
            </connector>
            <label>Pending/Solved Queue</label>
        </rules>
        <rules>
            <name>Closed_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentCase.Status</leftValueReference>
                <operator>Contains</operator>
