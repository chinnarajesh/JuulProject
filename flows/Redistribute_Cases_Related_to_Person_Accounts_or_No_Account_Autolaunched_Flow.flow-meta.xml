                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Pending_Solved_Cases_Get_Queue_ID_0</targetReference>
            </connector>
            <label>Closed Queue</label>
        </rules>
    </decisions>
