    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>/* Works with the &quot;Is New &amp;&amp; Is CRT role&quot; node in the &quot;Case_Trigger&quot; process to capture when a CRT accepts (or creates) a new case. */

AND(
  /* Is a Case or Chat Transcript */
  OR(
    BEGINS([AgentWork].WorkItemId, &apos;500&apos;),
    BEGINS([AgentWork].WorkItemId, &apos;570&apos;)
  ),

  /* Case accepted from omni-channel */
  ISPICKVAL([AgentWork].Status, &apos;Opened&apos;),

  /* User&apos;s role contains &apos;CRT&apos; */
  CONTAINS([AgentWork].User.UserRole.DeveloperName, &apos;CRT&apos;)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_3</name>
        <dataType>Boolean</dataType>
        <expression>/* Works with the &quot;Is New &amp;&amp; Is CRT role&quot; node in the &quot;Case_Trigger&quot; process to capture when a CRT accepts (or creates) a new case. */

AND(
  /* Is a Case or Chat Transcript */
  OR(
    BEGINS({!myVariable_current.WorkItemId}, &apos;500&apos;),
    BEGINS({!myVariable_current.WorkItemId}, &apos;570&apos;)
  ),

  /* Case accepted from omni-channel */
  ISPICKVAL({!myVariable_current.Status}, &apos;Opened&apos;),

  /* User&apos;s role contains &apos;CRT&apos; */
  CONTAINS({!myVariable_current.User.UserRole.DeveloperName}, &apos;CRT&apos;)
)</expression>
    </formulas>
