<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if User has the PSG assigned</description>
        <name>Is_User_Already_Assigned</name>
        <label>Is User Already Assigned?</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Remove_PSG_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUserHasPSG</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varPermSetGroupAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Remove</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_PSG_from_User</targetReference>
            </connector>
            <label>Remove PSG – Assigned</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determine whether the PSG was found</description>
        <name>PSG_Found</name>
        <label>PSG Found</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>NOT FOUND</defaultConnectorLabel>
        <rules>
            <name>FOUND</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPermissionSetGroupId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lookup_Permission_Set_Assignment</targetReference>
            </connector>
            <label>FOUND</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Remove a user from a Permission Set Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Remove a user from a Permission Set Group</label>
    <processMetadataValues>
