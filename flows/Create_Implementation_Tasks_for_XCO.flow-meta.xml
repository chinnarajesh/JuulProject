    <formulas>
        <name>GrabNextValue</name>
        <dataType>String</dataType>
        <expression>LEFT({!UpdatedOriginalSelectedGroups}, (FIND(&quot;;&quot;, {!UpdatedOriginalSelectedGroups}) -1))</expression>
    </formulas>
    <formulas>
        <name>ImplementationTaskName</name>
        <dataType>String</dataType>
        <expression>{!Get_Change.Name} &amp; &quot; / &quot; &amp; {!ThisLoopGroup} &amp; &quot; / Implementation Task&quot;</expression>
    </formulas>
    <formulas>
        <name>ProjectNameFormula</name>
        <dataType>String</dataType>
        <expression>{!Get_Change.Name} &amp; &quot; - &quot; &amp; {!ThisLoopGroup} &amp; &quot; Project&quot;</expression>
    </formulas>
    <formulas>
        <name>RemainingValue</name>
        <dataType>String</dataType>
        <expression>RIGHT( {!UpdatedOriginalSelectedGroups}, (LEN({!UpdatedOriginalSelectedGroups}) - FIND(&quot;;&quot;, {!UpdatedOriginalSelectedGroups}) ) )</expression>
    </formulas>
    <formulas>
        <name>UpdatedOriginalSelectedGroupsFormula</name>
        <dataType>String</dataType>
        <expression>{!OriginalSelectedGroups} &amp; &quot;;&quot;</expression>
    </formulas>
