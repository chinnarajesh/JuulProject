    <description>When status changes to open from pending or solved, move the case into an Omni Queue for rerouting KRO</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(

ISCHANGED([Case].Status ), 

ISPICKVAL([Case].Status ,&quot;Open&quot;),

OR(
ISPICKVAL(PRIORVALUE([Case].Status ),&quot;Pending&quot;), 
ISPICKVAL(PRIORVALUE([Case].Status ),&quot;Solved&quot;))
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(

ISCHANGED({!myVariable_current.Status} ), 

ISPICKVAL({!myVariable_current.Status} ,&quot;Open&quot;),

OR(
ISPICKVAL(PRIORVALUE({!myVariable_current.Status} ),&quot;Pending&quot;), 
ISPICKVAL(PRIORVALUE({!myVariable_current.Status} ),&quot;Solved&quot;))
)</expression>
    </formulas>
