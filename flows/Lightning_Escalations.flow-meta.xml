<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Already_Escalated</name>
        <label>Already Escalated?</label>
        <locationX>41</locationX>
        <locationY>354</locationY>
        <defaultConnector>
            <targetReference>Escalation_Reason</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>TRUE_Already_Escalated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsEscalated</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Has_Already_Been_Escalated</targetReference>
            </connector>
            <label>TRUE</label>
        </rules>
    </decisions>
    <decisions>
        <name>checkForValidQueueName</name>
        <label>checkForValidQueueName</label>
        <locationX>580</locationX>
        <locationY>187</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>validQueueName</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCRTEmailCaseName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_ID_From_Queue_Name</targetReference>
            </connector>
            <label>validQueueName</label>
        </rules>
        <rules>
            <name>noQueueName</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCRTEmailCaseName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>noMarketScreen</targetReference>
            </connector>
            <label>noQueueName</label>
        </rules>
    </decisions>
    <description>Changed the flow to assign to proper CRT based on Market and Language using the CS Country Config custom metadata.</description>
    <dynamicChoiceSets>
        <name>SelectEscalationReason</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Escalation_Reason__c</picklistField>
        <picklistObject>Case</picklistObject>
    </dynamicChoiceSets>
    <formulas>
        <description>LoggedInUserName</description>
        <name>LoggedInUserName</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &apos; &apos; + {!$User.LastName}</expression>
    </formulas>
    <formulas>
        <name>runningUserId</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
    <interviewLabel>Lightning Escalations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lightning Escalations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Gets queue ID based on Developer Name from CS Country Config metadata.</description>
        <name>Get_ID_From_Queue_Name</name>
        <label>Get ID From Queue Name</label>
        <locationX>792</locationX>
        <locationY>185</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCRTEmailCaseName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <object>Group</object>
        <outputAssignments>
            <assignToReference>varCRTEmailCaseQueueId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <description>Queries CS Country Config metadata to find CRT queue based on Market and Language.</description>
        <name>Get_Queue_From_Metadata</name>
        <label>Get Queue From Metadata</label>
        <locationX>454</locationX>
        <locationY>181</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>checkForValidQueueName</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Language__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varLanguagePreference</elementReference>
            </value>
        </filters>
        <filters>
            <field>Market__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varMarket</elementReference>
            </value>
        </filters>
        <object>CS_Country_Config__mdt</object>
        <outputAssignments>
            <assignToReference>varCRTEmailCaseName</assignToReference>
            <field>CRT_Email_Case_Name__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Use_Current_Case</name>
        <label>Use Current Case</label>
        <locationX>49</locationX>
        <locationY>197</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Already_Escalated</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>varIsEscalated</assignToReference>
            <field>IsEscalated</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varIssue</assignToReference>
            <field>Issue__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varLanguagePreference</assignToReference>
            <field>Language_Preference__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varMarket</assignToReference>
            <field>Market__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varCaseOrigin</assignToReference>
            <field>Origin</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varTopic</assignToReference>
            <field>Topic__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <description>Updates escalated case and assigns to correct CRT queue based on Market and Language.</description>
        <name>Update_Case</name>
        <label>Update Case</label>
        <locationX>951</locationX>
        <locationY>183</locationY>
        <connector>
            <targetReference>endScreen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Escalated_By__c</field>
            <value>
                <elementReference>LoggedInUserName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Escalated_Case_Issue__c</field>
            <value>
                <elementReference>varIssue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Escalated_Case_Topic__c</field>
            <value>
                <elementReference>varTopic</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Escalation_Reason__c</field>
            <value>
                <elementReference>Select_Escalation_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsEscalated</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>varCRTEmailCaseQueueId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
