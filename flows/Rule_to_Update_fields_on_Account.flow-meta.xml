<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>FederalTaxIdentificationNumber</name>
        <dataType>String</dataType>
        <expression>{!$Record.Federal_Tax_Identification_Number__c}</expression>
    </formulas>
    <formulas>
        <name>TobaccoLicenseNumber</name>
        <dataType>String</dataType>
        <expression>{!$Record.Tobacco_License_Number__c}</expression>
    </formulas>
    <interviewLabel>Rule to Update fields on Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rule to Update fields on Account</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Federal_Tax_Identification_Number</name>
        <label>Update Federal Tax Identification Number</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Federal_Tax_Identification_Number__c</field>
            <value>
                <elementReference>FederalTaxIdentificationNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tobacco_License__c</field>
            <value>
                <elementReference>TobaccoLicenseNumber</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Federal_Tax_Identification_Number</targetReference>
        </connector>
        <filterFormula>IF( {!$Setup.Bypass_Workflow_Rules__c.Opportunity_Workflow_Rules__c} = TRUE,FALSE, AND( NOT(ISNEW()), AND({!$Record.RecordType.DeveloperName}= &apos;Distributer_Onboarding&apos;, OR(ISCHANGED({!$Record.Tobacco_License_Number__c}), ISCHANGED({!$Record.Federal_Tax_Identification_Number__c}) ) ) ) )</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
