),
AND(
CONTAINS({!myVariable_event_context.PDLM__Category__r.Name} , &quot;QUAL&quot;),
{!myVariable_myEvent.PDLM__Is_Update__c}  = TRUE,
{!myVariable_event_context.Change_Status_Name__c} = &quot;Qualification&quot;,
NOT ISBLANK({!myVariable_event_context.Accessible_By__c})
)
)</expression>
    </formulas>
    <formulas>
