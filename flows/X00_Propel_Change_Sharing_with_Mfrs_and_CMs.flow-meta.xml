    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
AND(
CONTAINS([PDLM__Change__c].PDLM__Category__r.Name , &quot;XCO&quot;),
[PDLM__Change_Event__e].PDLM__Is_Approved__c = TRUE,
NOT ISBLANK([PDLM__Change__c].Accessible_By__c)
),
AND(
CONTAINS([PDLM__Change__c].PDLM__Category__r.Name , &quot;DEV&quot;),
[PDLM__Change_Event__e].PDLM__Is_Update__c  = TRUE,
[PDLM__Change__c].Change_Status_Name__c = &quot;Active&quot;,
NOT ISBLANK([PDLM__Change__c].Accessible_By__c)
),
AND(
CONTAINS([PDLM__Change__c].PDLM__Category__r.Name , &quot;QUAL&quot;),
[PDLM__Change_Event__e].PDLM__Is_Update__c  = TRUE,
[PDLM__Change__c].Change_Status_Name__c = &quot;Qualification&quot;,
NOT ISBLANK([PDLM__Change__c].Accessible_By__c)
)
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
AND(
CONTAINS({!myVariable_event_context.PDLM__Category__r.Name} , &quot;XCO&quot;),
{!myVariable_myEvent.PDLM__Is_Approved__c} = TRUE,
NOT ISBLANK({!myVariable_event_context.Accessible_By__c})
),
AND(
CONTAINS({!myVariable_event_context.PDLM__Category__r.Name} , &quot;DEV&quot;),
